generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Section {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  stockQuantity Int
  costPrice     Decimal
  sellingPrice  Decimal
  imageUrl      String
  description   String
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactSubmission {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  brandModel       String?
  fuelType         String?
  registrationDate DateTime?
  message          String
  createdAt        DateTime @default(now())
}